OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime-2.1-mini
REALTIME_VOICE=shimmer
# Stable ALSA name rather than a card number that can change after reboot.
ALSA_DEVICE=hw:wm8960soundcard,0
# Software playback gain; does not change the HAT mixer settings.
SPEAKER_GAIN=0.25
# WM8960 mic input gain: 23 = 0 dB. Original mixer value restored on exit.
MIC_CAPTURE_VOLUME=23
LED_GPIO=12
LED_COUNT=12
# The dim purple bench setting you chose: G=0, R=5, B=5.
LED_MAX_CHANNEL=5
LEDS_ENABLED=true
# Set true only after inserting the capacitive probe into the plant's soil.
# This records placement, not calibration; readings remain raw counts.
SOIL_PROBE_IN_SOIL=false
# Let Flora control Govee lamps on this network (turn on "LAN Control" in the
# Govee Home app for each lamp). Name them first: python -m flora lights
LIGHTS_ENABLED=false
