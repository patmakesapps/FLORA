OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime-2.1-mini
REALTIME_VOICE=shimmer
# Stable ALSA name rather than a card number that can change after reboot.
ALSA_DEVICE=hw:wm8960soundcard,0
# Software playback gain (0-1), applied before the HAT.
SPEAKER_GAIN=1.0
# WM8960 Speaker mixer while FLORA runs: 121 = 0 dB, 127 = +6 dB (max).
# Below the old 127 so start-up static is quieter. With SPEAKER_GAIN this sets
# voice volume level 10, the loudest the set_volume tool allows. Muted on exit.
SPEAKER_VOLUME=121
# WM8960 mic input gain: 23 = 0 dB. Original mixer value restored on exit.
MIC_CAPTURE_VOLUME=23
LED_GPIO=12
LED_COUNT=12
# The dim purple bench setting you chose: G=0, R=5, B=5.
LED_MAX_CHANNEL=5
LEDS_ENABLED=true
# Set true only after inserting the capacitive probe into the plant's soil.
# This records placement, not calibration; readings remain raw counts.
SOIL_PROBE_IN_SOIL=false
# Let Flora control Govee lamps on this network (turn on "LAN Control" in the
# Govee Home app for each lamp). Name them first: python -m flora lights
LIGHTS_ENABLED=false
# "Hey Flora" wake word, detected on the Pi by Picovoice Porcupine. Get a free
# AccessKey and train "Hey Flora" for Raspberry Pi at console.picovoice.ai, then
# copy the .ppn file to wake/hey-flora.ppn. Without both, FLORA stays connected
# to Realtime all the time, as before.
PICOVOICE_ACCESS_KEY=
WAKE_WORD_PATH=wake/hey-flora.ppn
WAKE_WORD_SENSITIVITY=0.5
# Seconds of silence before a conversation ends and FLORA returns to standby.
CONVERSATION_TIMEOUT=45
# Let FLORA shut the Pi down by voice. Needs deploy/flora-poweroff.sudoers.
POWER_OFF_ENABLED=false
